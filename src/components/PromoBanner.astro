---
interface Props {
  title: string;
  subtitle?: string;
  buttonLabel?: string;
  href?: string;
  accent?: 'mango' | 'cherry' | 'lime' | 'lemon';
}
const {
  title,
  subtitle,
  buttonLabel = 'Voir sur 1xCasino',
  href = '/info/',
  accent = 'mango',
} = Astro.props;
---
<div class={`promo-banner accent-${accent}`}>
  <div class="promo-copy">
    <p class="promo-title">{title}</p>
    {subtitle && <p class="promo-subtitle">{subtitle}</p>}
  </div>
  <a href={href} class="promo-btn" rel="nofollow sponsored noopener">{buttonLabel} →</a>
</div>

<style>
  .promo-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    background: linear-gradient(120deg, var(--base-800), var(--base-700));
    border: 2px solid var(--accent, var(--mango));
    border-radius: var(--radius-lg);
    padding: 22px 26px;
    margin: 36px 0;
    position: relative;
    overflow: hidden;
  }
  .promo-banner::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--accent, var(--mango)) 25%, transparent), transparent 60%);
    pointer-events: none;
  }
  .promo-copy { position: relative; z-index: 1; }
  .promo-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text-light);
    margin: 0 0 4px;
  }
  .promo-subtitle {
    margin: 0;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .promo-btn {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 700;
    background: var(--accent, var(--mango));
    color: var(--base-900);
    padding: 13px 24px;
    border-radius: 999px;
    white-space: nowrap;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .promo-btn:hover { transform: translateY(-2px); filter: brightness(1.08); }
</style>
