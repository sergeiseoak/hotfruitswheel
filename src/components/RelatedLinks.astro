---
interface LinkItem {
  href: string;
  label: string;
  accent?: 'mango' | 'cherry' | 'lime' | 'lemon';
}

interface Props {
  title?: string;
  links: LinkItem[];
}

const { title = 'À lire aussi', links } = Astro.props;
---
<nav class="related" aria-label={title}>
  <h2>{title}</h2>
  <ul>
    {links.map((link) => (
      <li>
        <a href={link.href} class={`related-link accent-${link.accent ?? 'mango'}`}>
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .related { margin-top: 56px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.1); }
  .related h2 { font-size: 1.2rem; margin-bottom: 16px; }
  .related ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .related-link {
    display: block;
    background: var(--base-800);
    border-radius: var(--radius-sm);
    padding: 14px 18px;
    border-left: 4px solid var(--accent, var(--mango));
    font-weight: 600;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .related-link:hover { transform: translateX(3px); background: var(--base-700); }
</style>
