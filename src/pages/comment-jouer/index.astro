---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import SlotMachine from '../../components/SlotMachine.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'comment-jouer');
if (!page) throw new Error('Missing src/content/pages/comment-jouer.md');
const { Content } = await page.render();
---
<BaseLayout
  title={page.data.metaTitle}
  description={page.data.metaDescription}
  path="/comment-jouer/"
>
  <section class="section">
    <div class="wrap article-layout">
      <div class="article-main">
        <h1>{page.data.h1}</h1>

        <PromoBanner
          title={`Mettez en pratique sur ${page.data.brand}`}
          subtitle={`${page.data.game} vous attend dans le catalogue de jeux.`}
          accent="lime"
        />

        <div class="prose">
          <Content />
        </div>

        <PromoBanner
          title="Prêt à lancer votre premier Spin ?"
          subtitle={`Ouvrez ${page.data.game} sur ${page.data.brand}.`}
          accent="mango"
        />

        <RelatedLinks
          title="À lire aussi"
          links={[
            { href: '/', label: `← ${page.data.game} sur ${page.data.brand} : le guide complet`, accent: 'mango' },
            { href: '/gratuit/', label: 'Tester Hot Fruits Wheel en mode gratuit', accent: 'cherry' },
            { href: '/versions-amatic/', label: 'Les différentes versions du jeu Amatic', accent: 'lime' },
          ]}
        />
      </div>

      <aside class="article-sidebar">
        <div class="sidebar-card">
          <SlotMachine size="medium" />
        </div>
        <div class="sidebar-card">
          <h3>Guides liés</h3>
          <ul class="sidebar-links">
            <li><a href="/">Le guide complet</a></li>
            <li><a href="/gratuit/">Mode gratuit / démo</a></li>
            <li><a href="/versions-amatic/">Versions Amatic</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
