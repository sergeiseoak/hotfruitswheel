---
import BaseLayout from '../layouts/BaseLayout.astro';
import SlotMachine from '../components/SlotMachine.astro';
import PromoBanner from '../components/PromoBanner.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'index');
if (!page) throw new Error('Missing src/content/pages/index.md');
const { Content } = await page.render();
---
<BaseLayout
  title={page.data.metaTitle}
  description={page.data.metaDescription}
  path="/"
>
  <section class="hero section">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>{page.data.h1}</h1>
        <p class="lead">
          Le guide indépendant du jeu {page.data.game} chez {page.data.brand} : mécaniques, symboles,
          Bonus Wheel et bonnes pratiques avant de jouer.
        </p>
        <div class="hero-actions">
          <a href="/gratuit/" class="btn ghost">Essayer en mode gratuit</a>
        </div>
      </div>
      <SlotMachine />
    </div>
  </section>

  <section class="section">
    <div class="wrap article-layout">
      <div class="article-main">
        <PromoBanner
          title={`${page.data.game} vous intéresse ?`}
          subtitle={`Retrouvez-le dès maintenant dans le catalogue ${page.data.brand}.`}
          accent="mango"
        />

        <div class="prose">
          <Content />
        </div>

        <PromoBanner
          title="Prêt à découvrir le jeu ?"
          subtitle={`Consultez ${page.data.game} dans le catalogue ${page.data.brand}.`}
          accent="cherry"
        />

        <RelatedLinks
          title="À lire aussi"
          links={[
            { href: '/gratuit/', label: 'Tester Hot Fruits Wheel en mode gratuit', accent: 'cherry' },
            { href: '/versions-amatic/', label: 'Les différentes versions du jeu Amatic', accent: 'lime' },
            { href: '/comment-jouer/', label: 'Comment jouer à Hot Fruits Wheel', accent: 'lemon' },
          ]}
        />
      </div>

      <aside class="article-sidebar">
        <div class="sidebar-card">
          <SlotMachine size="medium" />
        </div>
        <div class="sidebar-card">
          <h3>Guides liés</h3>
          <ul class="sidebar-links">
            <li><a href="/gratuit/">Mode gratuit / démo</a></li>
            <li><a href="/versions-amatic/">Versions Amatic</a></li>
            <li><a href="/comment-jouer/">Comment jouer</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 40px; align-items: center; }
  .hero-copy h1 { font-size: clamp(1.7rem, 3.4vw, 2.6rem); max-width: 20ch; }
  .lead { font-size: 1.05rem; max-width: 48ch; }
  .hero-actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 8px; }

  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
