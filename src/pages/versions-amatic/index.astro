---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import SlotMachine from '../../components/SlotMachine.astro';
import PromoBanner from '../../components/PromoBanner.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'versions-amatic');
if (!page) throw new Error('Missing src/content/pages/versions-amatic.md');
const { Content } = await page.render();
---
<BaseLayout
  title={page.data.metaTitle}
  description={page.data.metaDescription}
  path="/versions-amatic/"
>
  <section class="section">
    <div class="wrap article-layout">
      <div class="article-main">
        <h1>{page.data.h1}</h1>

        <PromoBanner
          title={`Découvrez la version proposée par ${page.data.brand}`}
          subtitle="Vérifiez directement dans le catalogue quelle édition est disponible."
          accent="lemon"
        />

        <div class="prose">
          <Content />
        </div>

        <PromoBanner
          title={`Envie de voir ${page.data.game} en action ?`}
          subtitle={`Ouvrez le catalogue ${page.data.brand}.`}
          accent="cherry"
        />

        <RelatedLinks
          title="À lire aussi"
          links={[
            { href: '/', label: `← ${page.data.game} sur ${page.data.brand} : le guide complet`, accent: 'mango' },
            { href: '/gratuit/', label: 'Tester Hot Fruits Wheel en mode gratuit', accent: 'cherry' },
            { href: '/comment-jouer/', label: 'Comment jouer à Hot Fruits Wheel', accent: 'lemon' },
          ]}
        />
      </div>

      <aside class="article-sidebar">
        <div class="sidebar-card">
          <SlotMachine size="medium" />
        </div>
        <div class="sidebar-card">
          <h3>Guides liés</h3>
          <ul class="sidebar-links">
            <li><a href="/">Le guide complet</a></li>
            <li><a href="/gratuit/">Mode gratuit / démo</a></li>
            <li><a href="/comment-jouer/">Comment jouer</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
