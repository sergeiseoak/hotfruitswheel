---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
---
<BaseLayout
  title="Versions et éditions Amatic — Hot Fruits Wheel"
  description="Panorama des différentes versions et éditions des jeux Amatic Industries, dont Hot Fruits Wheel 10 et 20."
  path="/versions-amatic/"
>
  <section class="section">
    <div class="wrap prose-wrap">
      <h1>Versions et éditions du jeu Amatic</h1>
      <p class="lead">
        Contenu à venir — cette page comparera les différentes éditions (Hot Fruits Wheel 10, 20, etc.).
      </p>
      <div class="prose">
        <p>
          Envoyez le contenu de cette page pour que Claude la remplace par le vrai texte, avec le
          même design que le reste du site.
        </p>
      </div>

      <RelatedLinks
        title="À lire aussi"
        links={[
          { href: '/', label: '← Hot Fruits Wheel sur 1xCasino : le guide complet', accent: 'mango' },
          { href: '/gratuit/', label: 'Tester Hot Fruits Wheel en mode gratuit', accent: 'cherry' },
          { href: '/comment-jouer/', label: 'Comment jouer à Hot Fruits Wheel', accent: 'lemon' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .prose-wrap { max-width: 700px; }
  .lead { font-size: 1.05rem; }
</style>
